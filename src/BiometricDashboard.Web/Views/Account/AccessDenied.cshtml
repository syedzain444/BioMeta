@{

    ViewData["Title"] = "Access denied";

    Layout = "_LoginLayout";

    ViewData["BodyClass"] = "login-body-os";

}



<div class="os-login-wallpaper portal-app-bg" aria-hidden="true"></div>



<div class="os-login-desktop">

    <header class="os-menubar os-menubar--login" role="banner">

        <div class="os-menubar-left">

            <span class="os-menubar-logo"><i class="bi bi-fingerprint"></i> GateOS</span>

        </div>

    </header>



    <div class="os-login-center">

        <div class="os-window access-denied-card">

            <div class="os-window-titlebar">

                <div class="os-window-controls" aria-hidden="true">

                    <span class="os-ctl-close"></span>

                    <span class="os-ctl-min"></span>

                    <span class="os-ctl-max"></span>

                </div>

                <span class="os-window-title">Access denied</span>

            </div>

            <div class="os-window-body">

                <div class="login-header">

                    <div class="login-icon"><i class="bi bi-shield-lock"></i></div>

                    <h1>Permission required</h1>

                    <p>Your account is signed in, but this app is not allowed for your role.</p>

                </div>

                <p class="muted" style="font-size:0.85rem;color:#64748b;">Ask an administrator to assign the permission, then sign out and sign in again.</p>

                <div class="login-actions">

                    <a class="btn-primary full" asp-controller="Dashboard" asp-action="Index">Open dashboard</a>

                    <form asp-action="Logout" asp-controller="Account" method="post" class="inline-form" style="margin-top:0.65rem;">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn-ghost full" style="width:100%;">Sign out</button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

