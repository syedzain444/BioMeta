@model BiometricDashboard.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LoginLayout";
    ViewData["BodyClass"] = "gateos-login";
    var sessionLocked = ViewBag.SessionLocked == true;
    var serverError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<div class="wallpaper" aria-hidden="true">
    <div class="orb a"></div>
    <div class="orb b"></div>
    <div class="orb c"></div>
    <div class="orb d"></div>
    <div class="grain"></div>
</div>

<div class="screen">
    <header class="topbar">
        <div class="brand">
            <div class="brand-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/><path d="M14 13.12c0 2.38 0 6.38-1 8.88"/><path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/><path d="M2 12a10 10 0 0 1 18-6"/><path d="M21.8 16c.2-2 .131-5.354 0-6"/><path d="M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2"/><path d="M8.65 22c.21-.66.45-1.32.57-2"/><path d="M9 6.8a6 6 0 0 1 9 5.2v2"/></svg>
            </div>
            GateOS
        </div>
        <div class="status"><i aria-hidden="true"></i>Nedo / Hanwang M2000A</div>
    </header>

    <main class="center">
        <div class="clock">
            <div class="time" id="time" aria-live="off">00:00<span class="sec">00</span></div>
            <div class="date" id="date">&nbsp;</div>
        </div>

        <div class="card" id="card">
            <div class="avatar" id="avatar">
                <div class="avatar-in">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                    <span id="initials"></span>
                </div>
            </div>
            <div class="who" id="who">Welcome back</div>
            <p class="hint @(sessionLocked ? "" : "is-hidden")" id="hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                Session locked. Sign in to continue.
            </p>

            <form id="loginForm" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="field">
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                    <input asp-for="EmployeeId" id="empId" type="text" placeholder="Employee ID" aria-label="Employee ID" autocomplete="username" autocapitalize="characters" spellcheck="false" autofocus required />
                </div>
                <div class="field pw">
                    <svg class="ic" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                    <input asp-for="Password" id="pwd" type="password" placeholder="Password" aria-label="Password" autocomplete="current-password" required />
                    <button class="eye" type="button" id="eye" aria-label="Show password" aria-pressed="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                    <button class="go" type="submit" aria-label="Sign in to GateOS">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                    </button>
                </div>
                <div class="caps" id="caps">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 9h-5v5H9v-5H4z"/><path d="M9 21h6"/></svg>
                    Caps Lock is on
                </div>
                <div class="msg" id="msg" role="alert">@(serverError ?? "")</div>
            </form>
        </div>
    </main>

    <footer class="bottom">
        <div class="opts">
            <button class="opt" type="button" aria-label="Light or dark appearance" title="Appearance" disabled>
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            </button>
            <button class="opt" type="button" aria-label="Help" title="Help">
                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7"/><path d="M12 17h.01"/></svg>
            </button>
        </div>
        <div class="chip"><i aria-hidden="true"></i>Gate Entry Biometric Portal · v1</div>
        <div class="tiles" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    </footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login-gateos.js" asp-append-version="true"></script>
}
