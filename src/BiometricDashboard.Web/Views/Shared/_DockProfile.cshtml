@model string
@{
    var name = Model?.Trim() ?? "User";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}"
        : (name.Length >= 2 ? name[..2] : name);
    initials = initials.ToUpperInvariant();
}
<div class="portal-dock-profile" title="@name">
    <div class="portal-dock-profile-card">
        <span class="portal-dock-profile-avatar" aria-hidden="true">@initials</span>
        <span class="portal-dock-online-dot" aria-label="Signed in"></span>
    </div>
</div>
