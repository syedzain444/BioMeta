@model string
@{
    var name = Model?.Trim() ?? "?";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}"
        : (name.Length >= 2 ? name[..2] : name);
    initials = initials.ToUpperInvariant();
    var hue = Math.Abs(name.GetHashCode()) % 360;
    var size = ViewData["AvatarSize"] as string ?? "md";
}
<span class="user-avatar user-avatar-@size" style="--avatar-hue:@hue" title="@name" aria-hidden="@(ViewData["AvatarDecorative"] as bool? == true ? "true" : "false")">@initials</span>
