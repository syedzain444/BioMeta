@model string
@{
    var name = Model?.Trim() ?? "User";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}"
        : (name.Length >= 2 ? name[..2] : name);
    initials = initials.ToUpperInvariant();
}
<div class="gateos-tray user" title="@name">
    <span class="gateos-av" aria-hidden="true">@initials</span>
    <span>@name</span>
</div>
