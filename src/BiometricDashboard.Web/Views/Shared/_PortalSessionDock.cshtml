@model string
@{
    var name = Model?.Trim() ?? "User";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[^1][0]}"
        : (name.Length >= 2 ? name[..2] : name);
    initials = initials.ToUpperInvariant();
}
<aside class="portal-session-dock" aria-label="Session">
    <div class="portal-session-dock-profile" title="@name">
        <div class="portal-session-dock-avatar-wrap">
            <span class="portal-session-dock-avatar" aria-hidden="true">@initials</span>
            <span class="portal-session-dock-online" aria-label="Signed in"></span>
        </div>
        <span class="portal-session-dock-name">@name</span>
    </div>
    <div class="portal-session-dock-actions">
        <form asp-controller="Account" asp-action="Lock" method="post" class="portal-session-dock-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="portal-session-dock-btn" title="Lock session" aria-label="Lock session">
                <i class="bi bi-lock-fill" aria-hidden="true"></i>
            </button>
        </form>
        <form asp-controller="Account" asp-action="Logout" method="post" class="portal-session-dock-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="portal-session-dock-btn" title="Sign out" aria-label="Sign out">
                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
            </button>
        </form>
    </div>
</aside>
